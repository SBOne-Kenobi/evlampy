{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "node",
      "args": ["esbuild.js"],
      "problemMatcher": ["$esbuild"],
      "group": "build"
    },
    {
      "label": "watch",
      "type": "process",
      "command": "node",
      "args": ["esbuild.js", "--watch"],
      "isBackground": true,
      "problemMatcher": ["$esbuild"],
      "group": "build"
    }
  ]
}
